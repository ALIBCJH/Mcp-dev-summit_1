ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Thinking settings for the demo. Unset = the model's own default.
# ANTHROPIC_THINKING: adaptive or between_tools ("disabled" is never sent).
# ANTHROPIC_THINKING_DISPLAY (adaptive only): omitted or summarized; summarized shows thinking in the panel.
# ANTHROPIC_EFFORT: low, medium, high, xhigh or max.
ANTHROPIC_THINKING=adaptive
ANTHROPIC_EFFORT=medium
ANTHROPIC_THINKING_DISPLAY=summarized
# WEB_PORT=8000   (the web app; PORT=9000 is the bookings server)
